{
  "name": "brandblog",
  "version": "1.0.0",
  "private": true,
  "description": "Static BrandBlog built with Pelican and Tailwind CSS using a Siemens-inspired visual identity.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./theme/static/css/style.css --minify",
    "build:cms-css": "tailwindcss -i ./cms/static/css/cms.src.css -o ./cms/static/css/cms.css --minify",
    "build": "npm run build:css && npm run build:cms-css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./theme/static/css/style.css --watch",
    "watch:cms-css": "tailwindcss -i ./cms/static/css/cms.src.css -o ./cms/static/css/cms.css --watch",
    "build:site": "pelican content -s publishconf.py -o output",
    "serve": "pelican content -s pelicanconf.py -l -r"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
